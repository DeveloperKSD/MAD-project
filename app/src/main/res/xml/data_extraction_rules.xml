<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <!-- noBackupFilesDir is excluded automatically from both mechanisms. -->
    <cloud-backup>
        <exclude domain="file" path="nostr_identity.enc" />
        <exclude domain="file" path="nostr_identity.enc.bak" />
        <exclude domain="file" path="relay_history/" />
        <exclude domain="database" path="relay-internet.db" />
        <exclude domain="database" path="relay-internet.db-wal" />
        <exclude domain="database" path="relay-internet.db-shm" />
        <exclude domain="database" path="relay-internet.db-journal" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="nostr_identity.enc" />
        <exclude domain="file" path="nostr_identity.enc.bak" />
        <exclude domain="file" path="relay_history/" />
        <exclude domain="database" path="relay-internet.db" />
        <exclude domain="database" path="relay-internet.db-wal" />
        <exclude domain="database" path="relay-internet.db-shm" />
        <exclude domain="database" path="relay-internet.db-journal" />
    </device-transfer>
</data-extraction-rules>
